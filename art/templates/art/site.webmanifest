{% load static %}{
  "name": "{{ site_name|escapejs }}",
  "short_name": "{{ site_name|escapejs }}",
  "icons": [
    {
      "src": "{% static 'art/favicon/web-app-manifest-192x192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "{% static 'art/favicon/web-app-manifest-512x512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#1c1c1c",
  "background_color": "#1c1c1c"
}
