# Copy to .env and fill in, then `docker compose up -d --build`.
# .env is gitignored and is NOT baked into the image (see .dockerignore).

# Public domain Caddy serves + provisions HTTPS for (also Django's ALLOWED_HOSTS).
# Use "localhost" for a quick local look (Caddy issues a self-signed cert).
DOMAIN=art.example.com

# Django secret key — generate a fresh one:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=change-me

# PostgreSQL. The db service and the app's DATABASE_URL are built from these.
POSTGRES_DB=artsite
POSTGRES_USER=artsite
POSTGRES_PASSWORD=change-me-too

# First admin, created on first boot. Leave the password blank to skip and create
# one yourself: `docker compose exec app python manage.py createsuperuser`.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=

# Set to 1 to load a few sample pieces on first boot (remove later with
# `docker compose exec app python manage.py seed_demo --clear`).
SEED_DEMO=0
