[Unit]
Description=PostgreSQL database for artsite
After=artsite-network.service

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=artsite-db
Network=artsite.network
# PostgreSQL data directory, bind-mounted from the service user's home
# (%h = /home/artsite under the §2 setup). Keep that home on local disk (SSD) —
# NEVER an NFS-mounted home, as Postgres's locking/fsync assumptions corrupt data
# over NFS (see deploy/SELF_HOSTING.md §1). install.sh creates this dir; Postgres
# initialises and chowns it on first start. :Z (exclusive SELinux label) since
# only this container touches it. Back it up with deploy/backup-db.sh (a logical
# dump), never by copying this directory while Postgres is running.
Volume=%h/db:/var/lib/postgresql/data:Z
EnvironmentFile=%h/.config/artsite/artsite.env
# $$ so systemd passes a literal $ through the generated ExecStart and the
# IN-CONTAINER shell expands the vars (quadlet doesn't escape $; a single $
# would be expanded — to empty — by systemd, which never sees the container
# env). -h 127.0.0.1 probes TCP: the postgres image's first-boot init runs a
# temp server on the unix socket only, and a socket-only pg_isready would
# report healthy (and, with Notify=healthy below, release the app unit)
# before the real server is listening.
HealthCmd=pg_isready -h 127.0.0.1 -U $${POSTGRES_USER} -d $${POSTGRES_DB}
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=10s
# Report "started" only once the healthcheck passes, so the app unit's
# After=artsite-db.service waits for Postgres to ACCEPT CONNECTIONS, not merely
# for the container process to exist — otherwise the app's migrate races the
# DB's startup on every boot. Needs podman 5.2+: the option arrived in 5.0 but
# panicked under ROOTLESS podman until 5.2 (containers/podman#22651).
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
