# Artsite Environment Configuration
# Copy this file to ~/.config/artsite/artsite.env and fill in the values

# Django settings
# Generate a fresh, random key (don't reuse one from anywhere):
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=your-secret-key-here
ENVIRONMENT=production
# Public hostname(s) this site is served on, comma-separated (no scheme/port).
# Required in production. localhost is always allowed in-app for the container
# healthcheck. CSRF trusted origins default to https://<each-host>; override with
# CSRF_TRUSTED_ORIGINS=... only if you need something other than that.
ALLOWED_HOSTS=art.example.com

# PostgreSQL settings (used by both postgres container and Django)
POSTGRES_DB=artsite
POSTGRES_USER=artsite
POSTGRES_PASSWORD=your-secure-password-here

# Database URL for Django (uses container name for hostname)
DATABASE_URL=postgres://artsite:your-secure-password-here@artsite-db:5432/artsite

# Off-site backup destination for deploy/backup-media.sh (media + documents) and
# the restore drill. A second disk/mount, or an rsync-over-ssh target like
# user@host:/srv/artsite-backup. Set MIRROR=1 to mirror (rsync --delete) instead
# of the safer additive default. (The restore drill needs a LOCAL path to mount.)
MEDIA_BACKUP_DEST=/mnt/offsite/artsite-backup

# Media/image storage.
# This self-hosted deployment uses the local filesystem: artsite.container sets
# STORAGE_BACKEND=local and bind-mounts the host media directory at MEDIA_ROOT
# (/data/media), plus a separate staff-only documents dir at PRIVATE_MEDIA_ROOT
# (/data/private, NOT served by Caddy). Nothing more is needed here for local
# storage.
#
# To use Google Cloud Storage instead, set STORAGE_BACKEND=gcs in
# artsite.container and provide a service-account key, e.g.:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcs-key.json
# then mount that key into the container. Never commit the key to the repo.
